# HyperData Terminal sidecar — upstream pin and defaults.
#
# The sidecar is a separate project consumed over HTTP, so pinning it here is
# what makes "update the sidecar" a deliberate, reviewable action rather than a
# side effect of rebuilding this repository.
#
# Upstream publishes no tags (checked 2026-09-22: the tags endpoint is empty), so
# HYPERDATA_REVISION is a commit SHA. That is the only way to get a reproducible
# build. `sidecar.sh update` moves it forward.

# Repository URL.
HYPERDATA_REPO="https://github.com/Co-Messi/HyperData-Terminal.git"

# Branch or tag used by `sidecar.sh update` when no explicit ref is given.
# main is upstream's only long-lived branch.
HYPERDATA_REF="main"

# Exact revision this adapter is known to work against.
#
# Verified 2026-09-22 against the contract test in
# marketdata/providers/hyperdata_contract_test.go. Upstream reported API
# version 1.0.0 at this revision, which matches hyperDataTestedMajor.
#
# Bumping this value is the whole upgrade procedure; run
# `./deploy/hyperdata/sidecar.sh update --to <ref>` and let it re-verify.
HYPERDATA_REVISION="148e1bbd1a9250018f5fe5a69509d6fb6a3e6589"

# The upstream major version this revision was verified against. It is stated
# machine-readably, not only in the comment above, because three places have to
# agree and a silent disagreement is the failure this file exists to prevent:
#
#   1. this value
#   2. hyperDataTestedMajor in marketdata/providers/hyperdata_client.go
#   3. the "version" inside fixtureHealth in hyperdata_contract_test.go
#
# TestUpstreamPinIsStillMeaningful asserts that all three match, so a partial
# bump fails the build. `sidecar.sh status` also compares it against the version
# the running sidecar reports.
HYPERDATA_TESTED_MAJOR="1"

# Where the checkout and its virtualenv live. Kept outside the repository so an
# upgrade can never dirty this working tree.
HYPERDATA_DIR="${HYPERDATA_DIR:-$HOME/.nofx/hyperdata}"

# Port the REST API listens on. Must match the strategy's base URL (or the
# HYPERDATA_BASE_URL environment variable).
HYPERDATA_PORT="8420"
